#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&gresc     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp EQUAL
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp MINUS
&kp LSHFT  &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LCTRL  &kp Z      &kp X      &kp C      &kp V      &kp B      &lt 3 LBKT &lt 3 RBKT   &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp BSLH
&kp LALT   &kp LGUI   &mo 1      &kp SPACE  &kp RET    &kp BSPC   &mt RSHFT DEL &mo 1
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12
&kp GRAVE       &trans          &trans          &trans          &trans          &trans          &bt BT_CLR      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &studio_unlock
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp C_VOL_DN    &kp UP          &kp C_VOL_UP
&trans          &trans          &trans          &trans          &trans          &trans          &kp CAPS        &kp PSCRN       &trans          &trans          &trans          &kp LEFT        &kp DOWN        &kp RIGHT
&trans          &trans          &trans          &trans          &trans          &kp DEL         &trans          &trans
            >;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp KP_NUM      &kp KP_SLASH    &kp KP_MULTIPLY &kp KP_MINUS    &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp KP_N7       &kp KP_N8       &kp KP_N9       &kp KP_PLUS     &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp KP_N4       &kp KP_N5       &kp KP_N6       &kp KP_PLUS     &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp KP_N1       &kp KP_N2       &kp KP_N3       &kp KP_ENTER    &trans
&trans          &trans          &trans          &trans          &trans          &kp KP_N0       &kp KP_N0       &kp KP_DOT
            >;
        };

        boot_layer {
            display-name = "Boot";
            bindings = <
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
&bootloader     &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &bootloader
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        extra_layer_4 {
            status = "reserved";
            bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
        };

        extra_layer_5 {
            status = "reserved";
            bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
        };

        extra_layer_6 {
            status = "reserved";
            bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
        };

        extra_layer_7 {
            status = "reserved";
            bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
        };

        extra_layer_8 {
            status = "reserved";
            bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
        };
    };
};
